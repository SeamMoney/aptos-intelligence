# GitHub Personal Access Token (free, for reading public repos)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# Groq API Key (free tier is generous for LLM calls)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx

# Twitter/X API v2 credentials (Free tier: ~500 posts/month)
X_API_KEY=xxxxxxxxxxxxxxxx
X_API_SECRET=xxxxxxxxxxxxxxxx
X_ACCESS_TOKEN=xxxxxxxxxxxxxxxx
X_ACCESS_SECRET=xxxxxxxxxxxxxxxx

# Bot configuration
CRON_SCHEDULE=0 */6 * * *
DRY_RUN=false
POST_IMPORTANCE_THRESHOLD=6
MAX_MONTHLY_POSTS=450

# Web UI (set WEB_ONLY=true to run just the website without Twitter)
WEB_ONLY=false
WEB_PORT=3000
