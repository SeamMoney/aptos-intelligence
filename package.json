{
  "name": "aptos-intelligence",
  "version": "1.0.0",
  "description": "AI-powered Aptos Core changelog & feature tracker Twitter bot",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dry-run": "DRY_RUN=true tsx src/index.ts",
    "run-once": "tsx src/run-once.ts",
    "web": "WEB_ONLY=true tsx src/web.ts",
    "web:build": "cd web && npm run build",
    "web:dev": "cd web && npm run dev",
    "web:serve": "npm run web:build && npm run web"
  },
  "keywords": [
    "aptos",
    "blockchain",
    "twitter-bot",
    "changelog"
  ],
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "dotenv": "^16.4.0",
    "groq-sdk": "^0.8.0",
    "node-cron": "^3.0.3",
    "tsx": "^4.0.0",
    "twitter-api-v2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.6.0"
  }
}
